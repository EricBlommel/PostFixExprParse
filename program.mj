final int OFFSET = 10;
int globalVar = 5;

void printErgebnis(int wert) {
    int temp = 0;
    {
        temp = wert + OFFSET;
        print(temp);
        test();
    }
}

func addiere(int a, int b) {
    int summe = 0;
    {
        summe = a + b;
        test();
    }
    return summe;
}

{
    printErgebnis(addiere(globalVar, 20));
}