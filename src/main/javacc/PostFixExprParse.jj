options {
    STATIC = false;
    OUTPUT_DIRECTORY = "../java/parser/";
}

PARSER_BEGIN(PostFixExprParse)
package parser;

import JavaClassFileGenerator.BytecodeGenerator;
import JavaClassFileGenerator.JavaClassFileGenerator;
import JavaClassFileGenerator.MethodObject;
import symbolTable.Method;
import symbolTable.SymbolTable;
import parser.exceptions.LWertException;
import parser.exceptions.RWertException;
import parser.exceptions.WrongParametersException;
import parser.exceptions.UnknownSymbolException;
import parser.exceptions.SymbolAlreadyDefinedException;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class PostFixExprParse {
    private final SymbolTable symbolTable = new SymbolTable();
    // Methoden-Speicher
    private final Map<String, Method> methods = new HashMap<>();
    private Method currentMethod;

    public static void main (String[] args) {
        PostFixExprParse parser = new PostFixExprParse(System.in);
        try {
            parser.program();

            JavaClassFileGenerator jcfg = new JavaClassFileGenerator("generated/Main", true, true, true);
            List<MethodObject> methodObjects = new ArrayList<>();

            // Bytecode aller Methoden einsammeln
            for (Method m : parser.methods.values()) {
                String hexCode;
                if (m.getName().equals("main")) {
                    hexCode = m.getCode().finishMain();
                } else {
                    hexCode = m.getCode().finish();
                }

                System.out.println("Method " + m.getName() + " Hex: " + hexCode);
                methodObjects.add(new MethodObject(m.getName(), m.getParamCount(), hexCode));
            }

            jcfg.generateClassFile(methodObjects.toArray(new MethodObject[0]));

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}

PARSER_END(PostFixExprParse)

SKIP: { " " | "\r" | "\n" | "\t" }

TOKEN: {
    < INT : "int" >
    | < FINAL : "final" >
    | < PRINT : "print" >
    | < IF : "if" >
    | < ELSE : "else" >
    | < WHILE : "while" >
    | < FUNC : "func" >
    | < VOID : "void" >
    | < RETURN : "return" >
    | < KLAMMERAUF : "(" >
    | < KLAMMERZU : ")" >
    | < CURLYAUF : "{" >
    | < CURLYZU : "}" >
    | < EQUAL : "=" >
    | < COMMA : "," >
    | < SEMICOLON : ";" >
    | < EQ : "==" > | < NE : "!=" > | < GE : ">=" > | < LE : "<=" > | < GT : ">" > | < LT : "<" >
    | < PLUS : "+" > | < MINUS : "-" > | < MULT : "*" > | < DIV : "/" >
    | < IDENT : ["a"-"z","A"-"Z"] (["a"-"z","A"-"Z","0"-"9","_"])* >
    | < NUMBER : "0" | (["1"-"9"] (["0"-"9"])*) >
}

void program() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException: {} {
    {
        // Main-Methode initialisieren
        currentMethod = new Method("main", false, symbolTable);
        currentMethod.addParameter("args");
        methods.put("main", currentMethod);
    }
    constDecl()
    varDecl(false) // Globale Variablen
    ( procedure() | function() )*

    // Kontext zurück auf Main für Hauptblock
    { currentMethod = methods.get("main"); }
    statement()
    <EOF>
}

void constDecl() throws SymbolAlreadyDefinedException: {} {
    ( <FINAL> <INT> constZuw() constList() <SEMICOLON> )?
}

void constZuw() throws SymbolAlreadyDefinedException: { Token ident; Token number; } {
  ident=<IDENT> <EQUAL> number=<NUMBER>
  { symbolTable.addConstant(ident.image, Integer.parseInt(number.image)); }
}

void constList() throws SymbolAlreadyDefinedException: {} {
    ( <COMMA> constZuw() constList() )?
}

void varDecl(boolean isLocal) throws SymbolAlreadyDefinedException: { Token ident; } {
    (
        <INT> ident=<IDENT>
        {
            if (isLocal) {
                currentMethod.addLocalVariable(ident.image);
            } else {
                symbolTable.addVariable(ident.image);
            }
        }
        varZuw(ident, isLocal)
        varList(isLocal)
        <SEMICOLON>
    )?
}

void varZuw(Token ident, boolean isLocal): { Token number; } {
    (
        <EQUAL> number=<NUMBER>
        {
            int val = Integer.parseInt(number.image);
            if (isLocal) {
                // Lokal: Wert auf Stack und speichern
                currentMethod.getCode().initLocalVar(currentMethod.getVarIndex(ident.image), val);
            } else {
                // Global: Init-Code in Main
                currentMethod.getCode().initVar(ident.image, val);
            }
        }
    )
    |
    {
        // Default-Initialisierung mit 0
        if (isLocal) {
            currentMethod.getCode().initLocalVar(currentMethod.getVarIndex(ident.image), 0);
        } else {
            currentMethod.getCode().initVar(ident.image, 0);
        }
    }
}

void varList(boolean isLocal) throws SymbolAlreadyDefinedException: { Token ident; } {
    (
        <COMMA> ident=<IDENT>
        {
            if (isLocal) currentMethod.addLocalVariable(ident.image);
            else symbolTable.addVariable(ident.image);
        }
        varZuw(ident, isLocal)
        varList(isLocal)
    )?
}

void expression() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {} {
    summe()
}

void summe() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {} {
    product()
    ( <PLUS> product() { currentMethod.getCode().add(); }
    | <MINUS> product() { currentMethod.getCode().sub(); } )*
}

void product() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {} {
    term()
    ( <MULT> term() { currentMethod.getCode().mul(); }
    | <DIV> term() { currentMethod.getCode().div(); } )*
}

void term() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    Token n; Token ident;
} {
    n=<NUMBER> { currentMethod.getCode().push(Integer.parseInt(n.image)); }
    |
    ident=<IDENT>
    (
        functionCall(ident)
        |
        {
            int localIndex = currentMethod.getVarIndex(ident.image);
            if (localIndex != -1) {
                currentMethod.getCode().loadLocal(localIndex);
            } else if (symbolTable.isConst(ident.image)) {
                currentMethod.getCode().push(symbolTable.constValue(ident.image));
            } else if (symbolTable.isVar(ident.image)) {
                currentMethod.getCode().loadGlobal(ident.image);
            } else {
                throw new RWertException("Bezeichner unbekannt oder keine Variable/Konstante: " + ident.image);
            }
        }
    )
    |
    <KLAMMERAUF> expression() <KLAMMERZU>
}

void functionCall(Token ident) throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    int argsCount = 0;
} {
    <KLAMMERAUF>
    ( expression() { argsCount++; } ( <COMMA> expression() { argsCount++; } )* )?
    <KLAMMERZU>
    {
        if (!methods.containsKey(ident.image)) {
             throw new UnknownSymbolException();
        } else {
             Method m = methods.get(ident.image);
             if (m.getParamCount() != argsCount) {
                 throw new WrongParametersException("Funktion " + ident.image + " erwartet " + m.getParamCount() + " Parameter, aber " + argsCount + " gegeben.");
             }
        }
        currentMethod.getCode().writeCall(ident.image, argsCount);
    }
}

void procCall(Token ident) throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    int argsCount = 0;
} {
    <KLAMMERAUF>
    ( expression() { argsCount++; } ( <COMMA> expression() { argsCount++; } )* )?
    <KLAMMERZU>
    {
        if (!methods.containsKey(ident.image)) {
             throw new UnknownSymbolException();
        }

        Method m = methods.get(ident.image);
        if (m.getParamCount() != argsCount) {
             throw new WrongParametersException("Prozedur " + ident.image + " erwartet " + m.getParamCount() + " Parameter, aber " + argsCount + " gegeben.");
        }

        currentMethod.getCode().writeCall(ident.image, argsCount);
    }
}

void procedure() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    Token ident;
} {
    <VOID> ident=<IDENT>
    {
        Method m = new Method(ident.image, false, symbolTable);
        methods.put(ident.image, m);
        currentMethod = m;
    }
    <KLAMMERAUF> routinenParameter() <KLAMMERZU>
    <CURLYAUF> routinenBlock() <CURLYZU>
    {
        currentMethod.getCode().returnVoid();
    }
}

void function() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    Token ident;
} {
    <FUNC> ident=<IDENT>
    {
        Method m = new Method(ident.image, true, symbolTable);
        methods.put(ident.image, m);
        currentMethod = m;
    }
    <KLAMMERAUF> routinenParameter() <KLAMMERZU>
    <CURLYAUF>
    routinenBlock()
    <RETURN> expression() <SEMICOLON>
    <CURLYZU>
    {
        currentMethod.getCode().returnInt();
    }
}

void routinenParameter(): { Token ident; } {
    ( <INT> ident=<IDENT> { currentMethod.addParameter(ident.image); }
      ( <COMMA> <INT> ident=<IDENT> { currentMethod.addParameter(ident.image); } )* )?
}

void routinenBlock() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {} {
    constDecl()
    varDecl(true)
    statement()
}

int condition() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    Token op; int jumpPlaceholder;
} {
  expression()
  ( op=<EQ> | op=<NE> | op=<GE> | op=<GT> | op=<LE> | op=<LT> )
  expression()
  {
    switch (op.kind) {
      case EQ: jumpPlaceholder = currentMethod.getCode().if_icmpne(); break;
      case NE: jumpPlaceholder = currentMethod.getCode().if_icmpeq(); break;
      case LT: jumpPlaceholder = currentMethod.getCode().if_icmpge(); break;
      case GE: jumpPlaceholder = currentMethod.getCode().if_icmplt(); break;
      case GT: jumpPlaceholder = currentMethod.getCode().if_icmple(); break;
      case LE: jumpPlaceholder = currentMethod.getCode().if_icmpgt(); break;
      default: throw new ParseException("wrong condition token");
    }
    return jumpPlaceholder;
  }
}

void statement() throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    Token ident; int falseJump; int loopStart;
} {
    ident=<IDENT>
    (
        <EQUAL> expression() <SEMICOLON>
        {
            int localIndex = currentMethod.getVarIndex(ident.image);
            if (localIndex != -1) {
                currentMethod.getCode().storeLocal(localIndex);
            } else if (symbolTable.isVar(ident.image)) {
                currentMethod.getCode().storeGlobal(ident.image);
            } else {
                 throw new LWertException("Zuweisung nur an Variablen erlaubt (unbekannt): " + ident.image);
            }
        }
        |
        procCall(ident) <SEMICOLON>
    )
    |
    <PRINT> <KLAMMERAUF> expression() <KLAMMERZU> <SEMICOLON>
    { currentMethod.getCode().print(); }
    |
    <CURLYAUF> ( statement() )* <CURLYZU>
    |
    <IF> falseJump=condition() statement() optElse(falseJump)
    |
    <WHILE> { loopStart = currentMethod.getCode().pc(); }
    falseJump=condition() statement()
    {
        int back = currentMethod.getCode().ifFalse_goto();
        currentMethod.getCode().patchJumpPlaceholder(back, loopStart);
        currentMethod.getCode().patchJumpPlaceholder(falseJump, currentMethod.getCode().pc());
    }
}

void optElse(int falseJump) throws LWertException, UnknownSymbolException, SymbolAlreadyDefinedException, RWertException, WrongParametersException: {
    boolean hasElse = false; int endJump = -1;
} {
    ( <ELSE>
      {
        hasElse = true;
        endJump = currentMethod.getCode().ifFalse_goto();
        currentMethod.getCode().patchJumpPlaceholder(falseJump, currentMethod.getCode().pc());
      }
      statement()
      { currentMethod.getCode().patchJumpPlaceholder(endJump, currentMethod.getCode().pc()); }
    )?
    {
        if (!hasElse) {
            currentMethod.getCode().patchJumpPlaceholder(falseJump, currentMethod.getCode().pc());
        }
    }
}

